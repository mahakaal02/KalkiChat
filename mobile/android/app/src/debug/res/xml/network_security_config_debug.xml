<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-VARIANT network security config.

  Permits cleartext HTTP only on the well-known dev host endpoints:
    * 10.0.2.2 — Android emulator's host-loopback bridge (the host's
      127.0.0.1 as seen from inside the emulator).
    * localhost / 127.0.0.1 — for the rare case the dev runs the app
      on a real device with a TCP-forwarded backend.

  Production builds use res/xml/network_security_config.xml which has
  cleartextTrafficPermitted="false" globally. The debug AndroidManifest
  override (src/debug/AndroidManifest.xml) swaps this in only for the
  debug variant via tools:replace.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
