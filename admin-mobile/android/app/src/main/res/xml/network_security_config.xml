<?xml version="1.0" encoding="utf-8"?>
<!--
  PRODUCTION network security config for the admin companion-device app.

  Mirrors mobile/android/app/src/main/res/xml/network_security_config.xml.
  Cleartext is hard-blocked globally; SSL pin enforcement is performed at
  the HTTP-client layer (see core/api.dart). System CA trust anchors only.

  The debug variant at src/debug/res/xml/network_security_config_debug.xml
  permits cleartext to 10.0.2.2 / localhost so emulator builds can reach
  the local backend.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
