# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=kalki
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=kalki
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://kalki:change-me-in-prod@postgres:5432/kalki?sslmode=disable

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Object storage (MinIO in dev, S3 in prod) ───────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=kalki-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ── Server ──────────────────────────────────────────────────────────────────
SERVER_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ── JWT ─────────────────────────────────────────────────────────────────────
# In production these MUST be loaded from a secret manager. Generate via:
#   openssl genpkey -algorithm Ed25519 -out ed25519.pem
#   openssl pkey -in ed25519.pem -pubout
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ── Argon2id ────────────────────────────────────────────────────────────────
ARGON2_MEMORY_KIB=65536
ARGON2_TIME=3
ARGON2_PARALLELISM=2

# ── Admin / TOTP ────────────────────────────────────────────────────────────
TOTP_ENC_KEY_HEX=000102030405060708090a0b0c0d0e0f000102030405060708090a0b0c0d0e0f

# ── Push ────────────────────────────────────────────────────────────────────
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8_PATH=/secrets/apns.p8
APNS_TOPIC=com.kalkichat.app

# ── Retention ───────────────────────────────────────────────────────────────
RETENTION_DAYS=30
RETENTION_SWEEP_INTERVAL=60s

# ── Admin web ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8080
ADMIN_SESSION_SECRET=replace-with-32-bytes-random
